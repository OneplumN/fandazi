[Unit]
Description=Fandazi street content service
After=network.target
[Service]
Type=simple
User=fandazi
Group=fandazi
WorkingDirectory=/opt/fandazi-content/current
EnvironmentFile=/etc/fandazi/content.env
ExecStart=/opt/fandazi-runtime/node-v22.23.4-linux-x64/bin/node server/content-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fandazi
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
